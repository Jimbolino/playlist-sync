# Copy to .env and adjust. See README.md / SCRAPER.md for scraper usage.

# --- Scraper CLI (src/index.ts) ---
# SQLite via libSQL; path after file: is relative to process cwd unless absolute
DATABASE_URL=file:./data/scraper.db

# Default --delay-ms when the flag is omitted (ms between pagination steps)
REQUEST_DELAY_MS=800

# Default --max-pages when the flag is omitted
MAX_PAGES=500

# Optional: directory for Playwright storage state per adapter (<adapterId>.json)
# STORAGE_STATE_DIR=.playwright-state

# Optional: Python interpreter for `sync-playlists` if not using ./.venv/bin/python
# VENV_PYTHON=/path/to/.venv/bin/python

# --- Playlist sync (python/sync_playlists.py) ---
# Same DB as scraper unless overridden with --db
# DATABASE_URL=file:./data/scraper.db

# ytmusicapi auth: path to browser headers JSON from `ytmusicapi browser`
# OR path to oauth.json from `ytmusicapi oauth` (then set client id/secret below)
YTMUSIC_HEADERS_PATH=secrets/ytmusic_headers.json

# Required when YTMUSIC_HEADERS_PATH points at oauth.json (GCP OAuth client: TVs and Limited Input devices)
# Aliases: YTMUSIC_OAUTH_CLIENT_ID / YTMUSIC_OAUTH_CLIENT_SECRET
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# SpotAPI session: JSON with "identifier" and "cookies" (see SpotAPI docs)
SPOTIFY_SESSION_PATH=secrets/spotify_session.json

# Optional default playlist ids (CLI flags override)
# YTMUSIC_PLAYLIST_ID=PLxxxxxxxx
# SPOTIFY_PLAYLIST_ID=xxxxxxxxxxxxxxxxxxxxxx
